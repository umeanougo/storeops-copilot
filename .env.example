# Demo mode is the safe default. Set to live only for a Shopify development store.
STOREOPS_DATA_MODE=demo

# Optional Shopify custom-app credentials (server-side only)
SHOPIFY_STORE_DOMAIN=your-development-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_VERSION=2026-07
SHOPIFY_MERCHANT_NAME=Connected merchant
SHOPIFY_STORE_NAME=Connected Shopify store
FULFILLMENT_PROVIDER_NAME=Connected fulfilment provider

# Optional multi-store server configuration. Keep this server-side and never
# commit real tokens. Each object requires id, merchantId, merchantName,
# storeName, domain, token, and optional apiVersion/serviceLevelTargetHours.
# SHOPIFY_STORES_JSON=[{"id":"store_1","merchantId":"merchant_1","merchantName":"Example merchant","storeName":"Example store","domain":"example.myshopify.com","token":"shpat_..."}]

# Optional AI synthesis. Deterministic fallbacks work without this key.
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=gpt-5.6-terra
